# ── ClickCard Admin panel ──────────────────────────────────────────────────
# Backend base URL — every API call the admin panel makes goes here.
NEXT_PUBLIC_API_BASE_URL=https://click-card-backend.vercel.app

# This admin app's own public URL.
NEXT_PUBLIC_SITE_URL=https://localhost:3001

# Main ClickCard web app — the login screen's "Go back to ClickCard" link.
NEXT_PUBLIC_WEB_URL=https://clickcard-2.vercel.app
